<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
    <!-- mapUnderscoreToCamelCase: DB 필드명 (ex: user_name) → Java 필드명 (userName) 자동 변환 -->
    <settings>
        <setting name="mapUnderscoreToCamelCase" value="true"/>
    </settings>

    <!-- 도메인 패키지 설정 (VO, DTO 등) -->
    <typeAliases>
        <package name="com.ptu.noriteo.model"/>
    </typeAliases>
</configuration>
