    <!-- 댓글 리스트 불러오기 -->
    <select id="getCommentsByBoardId" resultType="com.ptu.noriteo.model.BoardComment">
        SELECT *
        FROM BOARD_COMMENT
        WHERE BOARD_ID = #{boardId}
        ORDER BY REF ASC, STEP ASC
    </select>






    <select id="selectMyComments" parameterType="long" resultType="com.ptu.noriteo.model.BoardComment">
        SELECT *
        FROM BOARD_COMMENT
        WHERE USER_ID = #{userId}
        ORDER BY BOARD_COMMENT_REGDATE DESC
    </select>



    <insert id="insertReplyComment" parameterType="com.ptu.noriteo.model.BoardComment">
        <selectKey keyProperty="boardCommentId" resultType="long" order="BEFORE">
            SELECT BOARD_COMMENT_SEQ.NEXTVAL FROM DUAL
        </selectKey>

        INSERT INTO BOARD_COMMENT (
        BOARD_COMMENT_ID,
        BOARD_ID,
        USER_ID,
        BOARD_COMMENT_CONTENT,
        BOARD_COMMENT_REGDATE,
        REF,
        STEP,
        DEPTH,
        PARENT_ID
        )
        VALUES (
        #{boardCommentId},
        #{boardId},
        #{userId},
        #{boardCommentContent},
        SYSTIMESTAMP,
        <if test="ref != null">
            #{ref, jdbcType=NUMERIC},
        </if>
        <if test="ref == null">
            NULL,
        </if>
        #{step},
        #{depth},
        <if test="parentId != null">
            #{parentId, jdbcType=NUMERIC}
        </if>
        <if test="parentId == null">
            NULL
        </if>
        )
    </insert>


    <!-- STEP 정렬을 위해 기존 댓글들 STEP 증가시키기 -->
    <update id="updateStepsForReply">
        UPDATE BOARD_COMMENT
        SET STEP = STEP + 1
        WHERE REF = #{ref} AND STEP > #{step}
    </update>


    <select id="findById" resultType="com.ptu.noriteo.model.BoardComment">
        SELECT *
        FROM BOARD_COMMENT
        WHERE BOARD_COMMENT_ID = #{commentId}
    </select>


