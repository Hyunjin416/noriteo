    <insert id="insertComment" parameterType="com.ptu.noriteo.model.BoardComment">
        <selectKey keyProperty="boardCommentId" resultType="long" order="BEFORE">
            SELECT BOARD_COMMENT_SEQ.NEXTVAL FROM DUAL
        </selectKey>

        INSERT INTO BOARD_COMMENT (
        BOARD_COMMENT_ID,
        BOARD_ID,
        USER_ID,
        BOARD_COMMENT_CONTENT,
        BOARD_COMMENT_REGDATE,
        REF,
        STEP,
        DEPTH,
        PARENT_ID
        )
        VALUES (
        #{boardCommentId},
        #{boardId},
        #{userId},
        #{boardCommentContent},
        SYSTIMESTAMP,
        <if test="ref != null">
            #{ref, jdbcType=NUMERIC},
        </if>
        <if test="ref == null">
            NULL,
        </if>
        #{step},
        #{depth},
        <if test="parentId != null">
            #{parentId, jdbcType=NUMERIC}
        </if>
        <if test="parentId == null">
            NULL
        </if>
        )
    </insert>




