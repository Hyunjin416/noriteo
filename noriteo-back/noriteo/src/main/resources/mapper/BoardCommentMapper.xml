    <update id="updateCommentRef" parameterType="com.ptu.noriteo.model.BoardComment">
        UPDATE BOARD_COMMENT
        SET REF = #{ref}
        WHERE BOARD_COMMENT_ID = #{boardCommentId}
    </update>


    <delete id="deleteComment">
        DELETE FROM BOARD_COMMENT
        WHERE BOARD_COMMENT_ID = #{boardCommentId}
          AND USER_ID = #{userId}
    </delete>


